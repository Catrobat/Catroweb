<?xml version="1.0"?>
<!-- 1 is the highest and 8 the lowest error level  -->
<psalm
        errorLevel="3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
        findUnusedBaselineEntry="true"
        findUnusedCode="false"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="bin" />
        <directory name="config" />
        <directory name="migrations" />
        <directory name="public" />
        <directory name="src" />
        <directory name="templates" />
        <directory name="tests" />
        <directory name="translations" />
        <ignoreFiles>
            <directory name="vendor" />
            <!-- Generated code -->
            <directory name="src/Api/OpenAPI/Server"/>
            <file name="config/reference.php"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <ForbiddenCode>
            <errorLevel type="info">
                <directory name="src/"/>
            </errorLevel>
        </ForbiddenCode>
        <InternalClass>
            <errorLevel type="info">
                <directory name="tests" />
            </errorLevel>
        </InternalClass>
        <InternalMethod>
            <errorLevel type="info">
                <directory name="tests" />
            </errorLevel>
            <!-- psalm/plugin-phpunit 1.3 makes test code internal; BearerAuthenticationTrait in src/ calls the
                 override in its test double, so that one call is reported from outside tests/. -->
            <errorLevel type="info">
                <referencedMethod name="Tests\PhpUnit\Api\Services\Base\BearerAuthenticationTraitTestClass::getCurrentRequest" />
            </errorLevel>
        </InternalMethod>
        <InvalidArgument>
            <errorLevel type="info">
                <file name="config/routes.php"/>
            </errorLevel>
        </InvalidArgument>
        <UndefinedMagicMethod>
            <errorLevel type="info">
                <directory name="tests" />
            </errorLevel>
        </UndefinedMagicMethod>
        <InvalidOperand>
            <errorLevel type="info">
                <directory name="src" />
            </errorLevel>
        </InvalidOperand>
        <InvalidAttribute>
            <errorLevel type="info">
                <directory name="src" />
                <directory name="tests" />
                <directory name="migrations" />
            </errorLevel>
        </InvalidAttribute>
        <InvalidArrayOffset>
            <errorLevel type="info">
                <directory name="src" />
                <directory name="tests" />
            </errorLevel>
        </InvalidArrayOffset>
        <!-- Psalm 7 enables the bundled psalm/plugin-symfony. This issue of it is a performance hint, not a
             bug: Doctrine infers the type of a DateTime or entity parameter correctly without one. -->
        <PluginIssue name="QueryBuilderSetParameter" errorLevel="info" />
    </issueHandlers>
</psalm>
