{% extends 'Layout/Base.html.twig' %}

{% block head %}
  {{ vite_entry_link_tags('search_page') }}
{% endblock %}

{% block body %}

  {% if docs_only %}
    <h1 dir="auto">{{ 'search.results'|trans({}, 'catroweb', docs_ui_locale) }}{% if q %} <bdi>“{{ q }}”</bdi>{% endif %}</h1>
  {% endif %}

  <div id="search-results"{% if docs_only %} class="search-docs-only" dir="auto"{% endif %}
       data-query="{{ q }}"
       data-theme="{{ theme() }}"
       data-base-url="{{ app.request.getBaseURL() }}"
       data-trans-search-results="{{ 'search.results'|trans({}, 'catroweb') }}"
       data-trans-projects="{{ 'projects'|trans({}, 'catroweb') }}"
       data-trans-users="{{ 'users'|trans({}, 'catroweb') }}"
       data-trans-studios="{{ 'studios'|trans({}, 'catroweb') }}"
       data-trans-no-projects="{{ 'search.noProjects'|trans({}, 'catroweb') }}"
       data-trans-no-users="{{ 'search.noUsers'|trans({}, 'catroweb') }}"
       data-trans-no-studios="{{ 'search.noStudios'|trans({}, 'catroweb') }}"
       data-trans-no-results="{{ 'search.noResults'|trans({}, 'catroweb') }}"
       data-trans-show-more="{{ 'show-more'|trans({}, 'catroweb') }}"
       data-trans-members="{{ 'members'|trans({}, 'catroweb') }}"
       data-trans-scratch-projects="{{ 'search.scratchProjects'|trans({}, 'catroweb') }}"
       data-trans-scratch-converting="{{ 'search.scratchConverting'|trans({'%app%': getThemeDisplayName()}, 'catroweb') }}"
       data-trans-scratch-converting-snackbar="{{ 'search.scratchConvertingSnackbar'|trans({}, 'catroweb') }}"
       data-trans-error="{{ 'somethingWentWrong'|trans({}, 'catroweb', docs_ui_locale) }}"
       data-locale="{{ docs_locale }}"
       data-docs-only="{{ docs_only ? 'true' : 'false' }}"
       data-docs-explicit-locale="{{ docs_explicit_locale }}"
       data-docs-sections="{{ docs_sections|json_encode|e('html_attr') }}"
       data-docs-first="{{ app.request.query.get('context', '') == 'docs' ? 'true' : 'false' }}"
       data-trans-docs="{{ 'docs.title'|trans({}, 'catroweb', docs_ui_locale) }}"
       data-trans-no-docs="{{ 'search.noDocs'|trans({}, 'catroweb', docs_ui_locale) }}"
       data-trans-docs-guides="{{ 'docs.search_guides'|trans({}, 'catroweb', docs_ui_locale) }}"
       data-trans-docs-bricks="{{ 'docs.search_bricks'|trans({}, 'catroweb', docs_ui_locale) }}"
       data-trans-docs-formula="{{ 'docs.search_formula'|trans({}, 'catroweb', docs_ui_locale) }}"
  >
  </div>

{% endblock %}

{% block javascript %}
    {{ vite_entry_script_tags('search_page') }}
{% endblock %}
