{# Reusable Material Web filled text field. #}
<md-filled-text-field id="{{ text_field.id }}"
                      class="d-block w-100 mb-2"
                      label="{{ text_field.label }}"
                      name="{{ text_field.name }}"
                      type="{{ text_field.type|default('text') }}"
                      tabindex="{{ text_field.tabindex|default(text_field.tab_index|default('0')) }}"
                      {% if text_field.autocomplete is defined %}autocomplete="{{ text_field.autocomplete }}"{% elseif text_field.type|default('') and text_field.type != 'password' %}autocomplete="{{ text_field.type }}"{% endif %}
                      {% if text_field.required ?? true %}required{% endif %}
                      value="{{ text_field.value|default() }}">
  {% if text_field.leading_icon|default() %}
    <span slot="leading-icon" class="material-icons" aria-hidden="true">{{ text_field.leading_icon }}</span>
  {% endif %}

  {% if text_field.trailing_icon|default() == 'visibility' %}
    <md-icon-button slot="trailing-icon"
                    class="password-toggle"
                    data-password-field="{{ text_field.id }}"
                    aria-label="Toggle password visibility">
      <span class="material-icons">visibility</span>
    </md-icon-button>
  {% elseif text_field.trailing_icon|default() %}
    <span slot="trailing-icon" class="material-icons" aria-hidden="true">{{ text_field.trailing_icon }}</span>
  {% endif %}
</md-filled-text-field>
