{# Wrapper template for a Material Web switch. #}
<div class="mb-4" style="display: flex;">
  <label for="{{ switch.id }}" data-toggle="tooltip" data-placement="top">{{ switch.label }}</label>
  <md-switch id="{{ switch.id }}"
             aria-label="{{ switch.label }}"
             {% if switch.selected == '1' %}selected{% endif %}
             style="margin-left: auto;"></md-switch>
  <input type="hidden" id="{{ switch.id }}-native" name="{{ switch.name }}" value="{{ switch.selected }}">
</div>
