{#

  Wrapper template for a simple usage of material chip sets.

  ===== Dependencies =====

    -


  ===== Example usage =====

  {% include 'Components/ChipSet.html.twig' with {
  'chips': [
    {
      'id': 'A',
      'icon': 'notifications',
      'title': '' ~ 'allNotifications'|trans({}, 'catroweb')
      'controls': 'section-A'
    },
    {
      'id': 'B',
      'icon': 'follower',
      'title': '' ~ 'allFollower'|trans({}, 'catroweb')
      'controls': 'section-b'
    },
  ]
} %}

#}

<md-chip-set class="scroll-wrapper nav" role="tablist">
  {% for chip in chips %}
    <md-filter-chip id="{{ chip.id }}"
                    class="chip {% if loop.first %}chip-selected{% else %}chip-default{% endif %}"
                    {% if loop.first %}selected{% endif %}
                    role="tab" aria-controls="{{ chip.controls }}" aria-selected="{{ loop.first }}">
      <span slot="icon" class="material-icons">{{ chip.icon }}</span>
      {{ chip.title }}
    </md-filter-chip>
  {% endfor %}
</md-chip-set>
