{# Reusable Material Web filled textarea. #}
<md-filled-text-field id="{{ text_area.id }}"
                      class="d-block w-100 {{ text_area.mb|default('mb-4') }}"
                      label="{{ text_area.label }}"
                      name="{{ text_area.name }}"
                      type="textarea"
                      rows="{{ text_area.rows|default('4') }}"
                      cols="400"
                      {% if text_area.max_length|default() %}maxlength="{{ text_area.max_length }}"{% endif %}
                      value="{{ text_area.value|default() }}">
  {% if text_area.leading_icon|default() %}
    <span slot="leading-icon" class="material-icons" aria-hidden="true">{{ text_area.leading_icon }}</span>
  {% endif %}
</md-filled-text-field>
