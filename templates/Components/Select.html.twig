{#
Wrapper template for a Material Web outlined select.

===== Dependencies =====

  - Components/Select.js
#}
<md-outlined-select id="{{ select.id }}"
                    label="{{ select.label }}"
                    value="{{ select.value|default('') }}"
                    menu-positioning="popover"
                    {% if select.leading_icon|default() %}has-leading-icon{% endif %}>
  {% if select.leading_icon|default() %}
    <span slot="start" class="material-icons">{{ select.leading_icon }}</span>
  {% endif %}
  <md-select-option value="" {% if not select.value|default() %}selected{% endif %}></md-select-option>
  {% for key, value in select.options %}
    <md-select-option value="{{ key }}" {% if key == select.value %}selected{% endif %}>
      <span slot="headline">{{ value }}</span>
    </md-select-option>
  {% endfor %}
</md-outlined-select>
<input type="hidden" name="{{ select.name }}" id="{{ select.id ~ '-native' }}" value="{{ select.value|default('') }}">
