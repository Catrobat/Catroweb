{# Reusable Material Web tab bar. #}
<md-tabs class="tab-bar-container" aria-label="Content sections">
  {% for tab in tabs %}
    <md-primary-tab id="{{ tab.id }}"
                    {% if loop.first %}active{% endif %}
                    aria-controls="{{ tab.controls }}">
      {% if tab.count_id is defined %}
        <span slot="icon" id="{{ tab.count_id }}">-</span>
      {% endif %}
      {{ tab.title }}
    </md-primary-tab>
  {% endfor %}
</md-tabs>
