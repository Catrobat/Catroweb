{# Material Web circular progress bar. #}
{% set diameter = size|default('large') == 'small' ? '24px' : (size|default('large') == 'medium' ? '36px' : '48px') %}
<div class="circular-progress"{% if spinner_id is defined %} id="{{ spinner_id }}"{% endif %}>
  <md-circular-progress indeterminate
                        aria-label="Circular Progress Bar"
                        style="width: {{ diameter }}; height: {{ diameter }};"></md-circular-progress>
</div>
