{% extends 'Docs/DocsLayout.html.twig' %}

{% from 'Docs/DocsLayout.html.twig' import translation_note %}

{% from 'Docs/DocsNavigation.html.twig' import toc %}

{% set compact_lesson = '/' in page.path and docs_nav.pages is empty and (page.toc is not empty or page.description) %}
{% set opening_has_goal = compact_lesson and page.description and (body_html|striptags|trim) starts with page.description|e %}

{% block title %}{{ page.title }} – {{ 'docs.title'|trans({}, 'catroweb') }}{% endblock %}
{% block meta_description %}{{ page.description }}{% endblock %}

{% block docs_article %}
  <article class="docs-article" lang="{{ page.locale|replace({_: '-'}) }}">
    {{ translation_note(page, fallback) }}

    <h1 class="docs-article__title">{{ page.title }}</h1>

    {% if page.path == 'index' %}
      <form class="docs-home-search" dir="auto" role="search" action="{{ path('empty_search') }}" method="get">
        <label for="docs-search-query">{{ 'docs.home_search'|trans({}, 'catroweb', docs_ui_locale) }}</label>
        <div class="docs-home-search__control">
          <input type="hidden" name="context" value="docs">
          <input type="hidden" name="scope" value="docs">
          {% if docs_locale_query.locale is defined %}
            <input type="hidden" name="locale" value="{{ docs_locale_query.locale }}">
          {% endif %}
          <input type="search" id="docs-search-query" name="q" maxlength="200" required>
          <button type="submit" aria-label="{{ 'docs.home_search_submit'|trans({}, 'catroweb', docs_ui_locale) }}"><span class="material-icons" aria-hidden="true">search</span></button>
        </div>
      </form>
    {% endif %}

    {% if page.toc|length > 1 %}
      {{ toc(page.toc, 'docs-toc-title') }}
    {% endif %}

    {% if compact_lesson and page.description and not opening_has_goal %}
      <p class="docs-lesson-goal" dir="auto">{{ page.description }}</p>
    {% endif %}

    <div class="docs-content{% if opening_has_goal %} docs-content--opening-goal{% endif %}">{{ body_html|raw }}</div>

    {% if page.path == 'index' %}
      {{ include('Docs/DocsHomeCards.html.twig') }}
    {% elseif docs_nav.pages is not empty %}
      <ul class="docs-pages">
        {% for item in docs_nav.pages %}
          <li><a class="docs-pages__link" href="{{ item.url }}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if previous or next %}
      {% set pager_language = docs_ui_locale|slice(0, 2)|lower %}
      <nav dir="{{ pager_language in ['ar', 'fa', 'he', 'ps', 'sd', 'ur'] ? 'rtl' : 'ltr' }}" class="docs-pager{% if page.path != 'index' and docs_nav.pages is empty %} docs-pager--lesson{% endif %}" aria-label="{{ ('previous'|trans({}, 'catroweb', docs_ui_locale) ~ ' / ' ~ 'next'|trans({}, 'catroweb', docs_ui_locale))|e('html_attr') }}">
        {% if previous %}
          <a class="docs-pager__link docs-pager__link--previous" rel="prev" href="{{ path('docs', {path: previous.path == 'index' ? '' : previous.path}|merge(docs_locale_query)) }}">
            <span class="docs-pager__arrow material-icons" aria-hidden="true">arrow_back</span>
            <span>{{ 'previous'|trans({}, 'catroweb', docs_ui_locale) }} · {{ previous.title }}</span>
          </a>
        {% endif %}
        {% if next %}
          <a class="docs-pager__link docs-pager__link--next" rel="next" href="{{ path('docs', {path: next.path == 'index' ? '' : next.path}|merge(docs_locale_query)) }}">
            <span>
              <span class="docs-pager__label">{{ 'next'|trans({}, 'catroweb', docs_ui_locale) }}</span>
              <strong>{{ next.title }}</strong>
            </span>
            <span class="docs-pager__arrow material-icons" aria-hidden="true">arrow_forward</span>
          </a>
        {% endif %}
      </nav>
    {% endif %}

    <p class="docs-improve">
      <a href="{{ edit_url }}" target="_blank" rel="noopener noreferrer">
        <span class="material-icons" aria-hidden="true">edit</span>{{ 'docs.improve'|trans({}, 'catroweb') }}
      </a>
    </p>

    {{ include('Docs/Comments.html.twig', {doc_path: page.path}) }}
  </article>
{% endblock %}
