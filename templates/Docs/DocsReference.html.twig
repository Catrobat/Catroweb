{% extends 'Docs/DocsLayout.html.twig' %}

{% set kinds = {
  functions: 'docs.reference.functions'|trans({}, 'catroweb'),
  sensors: 'docs.reference.sensors'|trans({}, 'catroweb'),
  operators: 'docs.reference.operators'|trans({}, 'catroweb'),
} %}

{% block title %}{{ 'docs.reference.title'|trans({}, 'catroweb') }} – {{ 'docs.title'|trans({}, 'catroweb') }}{% endblock %}

{% block docs_article %}
  <article class="docs-article">
    <h1 class="docs-article__title">{{ 'docs.reference.title'|trans({}, 'catroweb') }}</h1>

    {% if categories is empty %}
      <p class="docs-note">{{ 'docs.reference.empty'|trans({}, 'catroweb') }}</p>
    {% endif %}

    {% set has_formula = formula.functions is not empty or formula.sensors is not empty or formula.operators is not empty %}
    {% if categories is not empty or has_formula %}
      <nav class="docs-reference__jump" dir="auto" aria-label="{{ 'docs.on_this_page'|trans({}, 'catroweb', docs_reference_locale) }}">
        <ul class="docs-reference__jump-list">
          {% for category in categories|filter(category => category.common) %}
            <li><a href="#{{ category.key }}">{% if category.jump_label %}{{ ('docs.reference_jump.' ~ category.jump_label)|trans({}, 'catroweb', docs_reference_locale) }}{% else %}{{ category.name }}{% endif %}</a></li>
          {% endfor %}
          {% if has_formula %}
            <li><a href="#formula">{{ 'docs.reference.formula'|trans({}, 'catroweb', docs_reference_locale) }}</a></li>
          {% endif %}
        </ul>
        {% set specialist = categories|filter(category => not category.common) %}
        {% if specialist is not empty %}
          <details>
            <summary>{{ 'show-more'|trans({}, 'catroweb', docs_reference_locale) }}</summary>
            <ul class="docs-reference__jump-list">
              {% for category in specialist %}
                <li><a href="#{{ category.key }}">{{ category.name }}</a></li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}
      </nav>
    {% endif %}

    {% for category in categories %}
      <section class="docs-reference__category" id="{{ category.key }}">
        <h2 class="docs-reference__heading cv-block cv-block--{{ category.color }}">{{ category.name }}</h2>
        <ul class="docs-reference__bricks">
          {% for brick in category.bricks %}
            <li><a class="docs-reference__brick" href="{{ path('docs_brick', {type: brick.type, category: category.key}|merge(docs_locale_query)) }}">{{ category.html[loop.index0]|raw }}</a></li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}

    {% if has_formula %}
      <section class="docs-reference__category" id="formula">
        <h2>{{ 'docs.reference.formula'|trans({}, 'catroweb') }}</h2>
        {% for kind, label in kinds %}
          <h3>{{ label }}</h3>
          <ul class="docs-reference__formula">
            {% for element in formula[kind] %}
              <li><a href="{{ path('docs_formula', {name: element.name}|merge(docs_locale_query)) }}"><span class="cv-field">{{ element.label ?? element.name }}</span></a></li>
            {% endfor %}
          </ul>
        {% endfor %}
      </section>
    {% endif %}
  </article>
{% endblock %}
