{# The docs frame: breadcrumb, the pages of the section beside the page and the docs entry. The sections themselves are
   in the app sidebar (Layout/Sidebar.html.twig). Pages fill docs_article and pass docs_nav (DocsController::docsNav),
   alternates, x_default_url (and canonical_url, markdown_url). #}
{% extends 'Layout/Base.html.twig' %}

{% from 'Docs/DocsNavigation.html.twig' import breadcrumb, toc %}

{# Whether the shown text is English standing in, an outdated or an automatic translation. #}
{% macro translation_note(page, fallback) %}
  {% if fallback %}
    <p class="docs-note" lang="{{ app.request.locale|slice(0, 2) }}">{{ 'docs.fallback'|trans({}, 'catroweb') }}</p>
  {% elseif page.translationState == 'stale' %}
    <p class="docs-note" lang="{{ app.request.locale|slice(0, 2) }}">{{ 'docs.stale'|trans({}, 'catroweb') }}</p>
  {% elseif page.translationState == 'current' and not page.reviewed %}
    <p class="docs-note docs-note--quiet" lang="{{ app.request.locale|slice(0, 2) }}">{{ 'docs.machine_translated'|trans({}, 'catroweb') }}</p>
  {% endif %}
{% endmacro %}

{% block top_bar_page_title %}{{ 'docs.title'|trans({}, 'catroweb') }}{% endblock %}

{% block hreflang %}
  {% for alternate in alternates %}
    <link rel="alternate" hreflang="{{ alternate.locale|replace({_: '-'}) }}" href="{{ alternate.url }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ x_default_url }}">
  {% if markdown_url is defined %}
    <link rel="alternate" type="text/markdown" href="{{ markdown_url }}">
  {% endif %}
{% endblock %}

{% block head %}
  {{ vite_entry_link_tags('docs_page') }}
{% endblock %}

{% block javascript %}
  {{ vite_entry_script_tags('docs_page') }}
{% endblock %}

{% block body %}
  <div class="docs{% if compact_lesson|default(false) %} docs--compact-lesson{% endif %}" {{ stimulus_controller('docs') }} data-action="click->docs#playVideo"
       data-trans-video="{{ 'docs.video'|trans({}, 'catroweb')|e('html_attr') }}">
    {% if docs_nav.crumbs is not empty %}
      {{ breadcrumb(docs_nav.crumbs) }}
    {% endif %}

    {% if docs_nav.siblings is not empty or compact_lesson|default(false) %}
      {# Closed on a phone so it does not push the page down, shown beside the page on a wide screen (DocsPage.css). #}
      <details class="docs-section{% if docs_nav.siblings is empty %} docs-section--phone-only{% endif %}" {{ stimulus_target('docs', 'section') }} data-action="toggle->docs#keepSectionOpen">
        <summary class="docs-section__summary">{{ 'docs.in_section'|trans({}, 'catroweb') }}</summary>
        {% if compact_lesson|default(false) %}
          <div class="docs-section__phone" dir="auto">
            {{ breadcrumb(docs_nav.crumbs) }}
            {{ toc(page.toc, 'docs-toc-phone-title') }}
          </div>
        {% endif %}
        {% if docs_nav.siblings is not empty %}
          <nav aria-label="{{ 'docs.in_section'|trans({}, 'catroweb')|e('html_attr') }}">
            <ul class="docs-section__list">
              {% for item in docs_nav.siblings %}
                <li>
                  <a class="docs-section__link{% if item.current %} docs-section__link--current{% endif %}" href="{{ item.url }}"
                     {% if item.current %}aria-current="page"{% endif %}>{{ item.title }}</a>
                </li>
              {% endfor %}
            </ul>
            {% if docs_nav.all_url %}
              <a class="docs-section__all" href="{{ docs_nav.all_url }}">{{ 'docs.all_in_section'|trans({}, 'catroweb') }}</a>
            {% endif %}
          </nav>
        {% endif %}
      </details>
    {% endif %}

    {% block docs_article %}{% endblock %}
  </div>
{% endblock %}
