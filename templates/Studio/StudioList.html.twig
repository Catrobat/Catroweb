
<div class="studios-list">
    {% for studio in studios %}
        {% if not public and studio.is_joined and joined or public and not studio.is_joined and not joined and studio.is_public and studio.is_enabled or not public and not joined and not studio.is_joined and not studio.is_public and studio.is_enabled %}
            <a href="{{ path('studio_details', {id: studio.id}) }}">
                <div class="studios-list-item">
                    {# cover_path now stores a basename key; template-rendered lists fall back to the default thumbnail.
                       API-backed lists receive full ImageVariants via StudioResponse.cover. #}
                    <img src="{{ asset('images/default/thumbnail-card@1x.webp') }}" class="img-fluid studios-list-item--image" alt="" width="360" height="360" loading="lazy">
                    <div class="studios-list-item--content">
                        <div class="studios-list-item--heading">
                            <h3>{{ studio.name }}</h3>
                            {% if not studio.is_public %}
                                <div class="studios-list-item--badge">
                                    <span class="material-icons">lock</span>
                                </div>
                            {% endif %}
                            {% if studio.is_joined %}
                                <!--<div class="studios-list-item--badge">
                                    <span class="material-icons">group_add</span>
                                </div>-->
                                <!--<div class="studios-list-item--text">(joined)</div>-->
                            {% endif %}
                        </div>
                        <div class="studios-list-item--icons">
                            <div class="studios-list-item--icon-wrapper">
                                <span class="material-icons">person</span>
                                <span id="studios-user-count-{{ studio.id }}" class="studios-list-item--icons-text ms-2">{{ studio.studio_users }}</span>
                            </div>
                            <div class="studios-list-item--icon-wrapper">
                                <span class="material-icons">app_shortcut</span>
                                <span class="studios-list-item--icon-text ms-2">{{ studio.studio_projects }}</span>
                            </div>
                        </div>
                    </div>
                    {% if user_name %}
                        <div class="studios-list-item--buttons">
                            <md-icon-button id="studios-list-item--button-{{ studio.id }}" data-studio-id="{{ studio.id }}" aria-label="Studio actions">
                                <span class="material-icons">more_vert</span>
                            </md-icon-button>
                            <md-menu id="studios-list-item--menu-{{ studio.id }}" anchor="studios-list-item--button-{{ studio.id }}" positioning="popover" data-studio-id="{{ studio.id }}">
                                    <md-menu-item>
                                        {% if not studio.is_joined and studio.status != 'pending' and studio.status != 'declined' %}
                                            <span id="requestJoin-{{ studio.id }}" slot="headline" class="ajaxRequestJoinLeaveReport ajaxRequestJoin"
                                                  data-url="/api/studios/{{ studio.id }}/join"
                                                  data-method="POST">
                                                 {{ 'studio.details.join'|trans({}, 'catroweb') }}
                                           </span>
                                        {% else %}
                                            {% if studio.status == 'pending' %}
                                                <span id="requestPending-{{ studio.id }}" slot="headline" class="requestPending">
                                                {{ 'studio.details.pending'|trans({}, 'catroweb') }}
                                                 </span>

                                            {% elseif studio.status == 'declined' %}
                                                    <span id="requestDecline-{{ studio.id }}" slot="headline" class="requestDecline">
                                                {{ 'studio.details.decline'|trans({}, 'catroweb') }}
                                                 </span>
                                            {% elseif studio.status == 'approved' or studio.is_joined %}
                                                <span id="requestLeave-{{ studio.id }}" slot="headline" class="ajaxRequestJoinLeaveReport ajaxRequestLeave"
                                                      data-url="/api/studios/{{ studio.id }}/leave"
                                                      data-method="DELETE">
                                                   {{ 'studio.details.leave'|trans({}, 'catroweb') }}
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    </md-menu-item>

                                    <md-menu-item>
                                        <span slot="headline" class="ajaxRequestJoinLeaveReport ajaxRequestReport"
                                              data-url="{{ path('studio_report', {id: studio.id}) }}">
                                            {{ 'studio.report'|trans({}, 'catroweb') }}"
                                        </span>
                                    </md-menu-item>
                            </md-menu>
                        </div>
                    {% endif %}
                </div>
            </a>
      {% endif %}
    {% endfor %}

</div>
