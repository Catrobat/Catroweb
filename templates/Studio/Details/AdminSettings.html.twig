<div class="modal fade modal-full" id="studio-admin-settings-modal" tabindex="-1" role="dialog" aria-hidden="true"
     data-studio-id="{{ studio.id }}"
     data-trans-save-success="{{ 'studio.details.admin_settings.save_success'|trans({}, 'catroweb') }}"
     data-trans-save-error="{{ 'studio.details.admin_settings.save_error'|trans({}, 'catroweb') }}">
  <div class="modal-dialog full-modal-dialog" role="document">
    <div class="modal-content full-modal-content">

      <div class="modal-header modal-header-full mdc-top-app-bar__row">
        <section class="mdc-top-app-bar__section mdc-top-app-bar__section--align-start">
          <button id="studio-settings__close-button" data-bs-dismiss="modal"
                  class="material-icons mdc-top-app-bar__action-item mdc-icon-button"
                  aria-label="Back to top bar">
            close
          </button>
          <span class="mdc-top-app-bar__title">{{ 'studio.details.admin_settings.title'|trans({}, 'catroweb') }}</span>
        </section>
        <section class="mdc-top-app-bar__section mdc-top-app-bar__section--align-end">
          <button id="studio-settings__submit-button" class="material-icons mdc-top-app-bar__action-item mdc-icon-button"
                  type="button">
            done
          </button>
        </section>
      </div>

      <div id="studio-settings" class="container-fluid justify-content-center">

        {{ include('Components/TextField.html.twig', {
          text_field:
          {
            id: 'studio-settings__studio-name',
            label: '' ~ 'studio.details.admin_settings.studio_name'|trans({}, 'catroweb'),
            value: studio.name,
            name: 'studio_name',
            leading_icon: 'blur_circular',
          },
        }) }}

        {{ include('Components/TextArea.html.twig', {
          text_area:
          {
            id: 'studio-settings__studio-description',
            label: '' ~ 'studio.details.admin_settings.studio_description'|trans({}, 'catroweb'),
            value: studio.description,
            name: 'studio_description',
            max_length: '1000',
            rows: '4',
          },
        }) }}

        {{ include('Components/Switch.html.twig', {
          switch:
          {
            id: 'studio-setting__switch-enable-comments',
            label: '' ~ 'studio.details.admin_settings.toggle_allow_comments'|trans({}, 'catroweb'),
            selected: studio.isAllowComments,
            name: 'allow_comments',
          },
        }) }}

        {{ include('Components/Switch.html.twig', {
          switch:
          {
            id: 'studio-setting__switch-studio-privacy',
            label: '' ~ 'studio.details.admin_settings.toggle_privacy'|trans({}, 'catroweb'),
            selected: studio.isPublic,
            name: 'is_public',
          },
        }) }}

        <section id="studio-invites" class="mt-4"
                 data-trans-uses="{{ 'studio.details.invites.uses'|trans({'%uses%': '%uses%'}, 'catroweb') }}"
                 data-trans-uses-max="{{ 'studio.details.invites.uses_max'|trans({'%uses%': '%uses%', '%max%': '%max%'}, 'catroweb') }}"
                 data-trans-expires="{{ 'studio.details.invites.expires'|trans({'%date%': '%date%'}, 'catroweb') }}"
                 data-trans-copy="{{ 'studio.details.invites.copy_link'|trans({}, 'catroweb') }}"
                 data-trans-copied="{{ 'studio.details.invites.copied'|trans({}, 'catroweb') }}"
                 data-trans-revoke="{{ 'studio.details.invites.revoke'|trans({}, 'catroweb') }}"
                 data-trans-none="{{ 'studio.details.invites.none'|trans({}, 'catroweb') }}"
                 data-trans-error="{{ 'studio.details.invites.error'|trans({}, 'catroweb') }}">
          <h3 class="h6">{{ 'studio.details.invites.title'|trans({}, 'catroweb') }}</h3>
          <p class="text-muted small">{{ 'studio.details.invites.hint'|trans({}, 'catroweb') }}</p>
          <div class="d-flex flex-wrap gap-2 align-items-end">
            <label class="small">
              {{ 'studio.details.invites.expires_on'|trans({}, 'catroweb') }}
              <input type="date" id="studio-invite-expires" class="form-control">
            </label>
            <label class="small">
              {{ 'studio.details.invites.max_uses'|trans({}, 'catroweb') }}
              <input type="number" id="studio-invite-max-uses" class="form-control" min="1" max="1000">
            </label>
            <button type="button" id="studio-invite-create" class="btn btn-outline-primary">
              {{ 'studio.details.invites.create'|trans({}, 'catroweb') }}
            </button>
          </div>
          <ul id="studio-invite-list" class="list-unstyled mt-3"></ul>
        </section>
      </div>
    </div>
  </div>
</div>
