<md-tabs id="studio-detail-tabs" class="container" aria-label="Studio sections">
  <md-primary-tab id="projects-tab" active aria-controls="projects-pane">
    <span class="tab-text">{{ 'studio.details.projects.title'|trans({}, 'catroweb') }}&nbsp;</span>
    <span id="projects-count" data-studio--project-list-target="count"><span class="skeleton studio-detail__tab-count-skeleton js-studio-header-skeleton"></span></span>
  </md-primary-tab>
  <md-primary-tab id="comments-tab" aria-controls="comments-pane">
    <span class="tab-text">{{ 'studio.details.comments.title'|trans({}, 'catroweb') }}&nbsp;</span>
    (<span id="comments-count" data-studio--comment-target="count"><span class="skeleton studio-detail__tab-count-skeleton js-studio-header-skeleton"></span></span>)
  </md-primary-tab>
</md-tabs>
