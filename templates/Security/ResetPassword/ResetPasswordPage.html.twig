{% extends 'Layout/Base.html.twig' %}

{% block head %}
  {{ vite_entry_link_tags('password_reset_page') }}
{% endblock %}

{% block body %}

<div class="content-card">
  <div class="row justify-content-center">
    <div class="login-container mb-4">

      <h1>{{ 'resetPassword.reset.title'|trans({}, 'catroweb') }}</h1>

      {% for flashError in app.flashes('reset_password_error') %}
        <div class="alert alert-danger">{{ flashError }}</div>
      {% endfor %}

      {{ form_start(resetForm, {attr: {novalidate: 'novalidate'}}) }}

        {% set firstField = resetForm.plainPassword.first %}
        {% set secondField = resetForm.plainPassword.second %}

        {# New password field #}
        <md-filled-text-field id="{{ firstField.vars.id }}"
                              class="d-block w-100 mb-2"
                              label="{{ firstField.vars.label|trans }}"
                              name="{{ firstField.vars.full_name }}"
                              type="password"
                              autocomplete="new-password"
                              required
                              tabindex="1"
                              {% if firstField.vars.errors|length > 0 %}error error-text="{{ firstField.vars.errors[0].message }}"{% endif %}>
          <span slot="leading-icon" class="material-icons" aria-hidden="true">lock</span>
          <md-icon-button slot="trailing-icon" class="password-toggle" data-password-field="{{ firstField.vars.id }}" aria-label="Toggle password visibility">
            <span class="material-icons">visibility</span>
          </md-icon-button>
        </md-filled-text-field>

        {# Repeat password field #}
        <md-filled-text-field id="{{ secondField.vars.id }}"
                              class="d-block w-100 mb-2"
                              label="{{ secondField.vars.label|trans }}"
                              name="{{ secondField.vars.full_name }}"
                              type="password"
                              autocomplete="new-password"
                              required
                              tabindex="2"
                              {% if secondField.vars.errors|length > 0 %}error error-text="{{ secondField.vars.errors[0].message }}"{% endif %}>
          <span slot="leading-icon" class="material-icons" aria-hidden="true">lock</span>
          <md-icon-button slot="trailing-icon" class="password-toggle" data-password-field="{{ secondField.vars.id }}" aria-label="Toggle password visibility">
            <span class="material-icons">visibility</span>
          </md-icon-button>
        </md-filled-text-field>

        {# Top-level errors (e.g., "passwords must match") #}
        {% if resetForm.plainPassword.vars.errors|length > 0 %}
          <div class="alert alert-danger mt-2">
            {{ resetForm.plainPassword.vars.errors[0].message }}
          </div>
        {% endif %}

        {{ form_widget(resetForm._token) }}

        <div class="mt-3">
          <button type="submit" class="btn btn-primary" tabindex="3">{{ 'resetPassword.reset.button.submit'|trans({}, 'catroweb') }}</button>
        </div>

      {{ form_end(resetForm, {render_rest: false}) }}

    </div>
  </div>
</div>
{% endblock %}

{% block javascript %}
{{ vite_entry_script_tags('password_reset_page') }}
{% endblock %}
