{# Google refuses OAuth inside embedded WebViews (disallowed_useragent), and older apps open it in the system
   browser, where the session ends up. In the app, sign in with username and password instead. #}
{% if not isWebview() %}
  <a class="social-login-btn" id="btn-login-google"
     href="{{ app.environment in ['dev', 'test'] ? path('dev_fake_oauth') : path('hwi_oauth_service_redirect', {service: 'google'}) }}">
    <img class="social-login-btn__img" alt="" src="{{ asset('images/social/btn_google_custom.png') }}"/>
    {{ 'login.oauth.google'|trans({}, 'catroweb') }}
  </a>
  {# Facebook and Apple OAuth disabled — see GitHub issues #6679 and #6680 #}

  <div class="login-divider">{{ 'login.oauth.or'|trans({}, 'catroweb') }}</div>
{% endif %}
