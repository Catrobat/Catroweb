{% extends 'Layout/Base.html.twig' %}

{% block head %}
  {{ vite_entry_link_tags('registration_page') }}
{% endblock %}

{% block header '' %}

{% block body %}

  <div class="content-card">

    <div class="row justify-content-center">
      <div class="login-container mb-4">

        <h1>{{ 'register.completeRegistration.title'|trans({}, 'catroweb') }}</h1>
        <p class="mb-4">{{ 'register.completeRegistration.info'|trans({}, 'catroweb') }}</p>

        {% for message in app.flashes('error') %}
          <div class="alert alert-danger mb-3">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('complete_registration_submit') }}" id="complete-registration-form">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('complete_registration') }}">

          <md-filled-text-field id="date-of-birth"
                                class="d-block w-100 mb-2"
                                label="{{ 'register.dateOfBirth'|trans({}, 'catroweb') }}"
                                supporting-text="{{ 'register.dateOfBirthInfo'|trans({}, 'catroweb') }}"
                                name="date_of_birth"
                                type="date"
                                max="{{ 'now'|date('Y-m-d') }}"
                                required
                                tabindex="1">
            <span slot="leading-icon" class="material-icons" aria-hidden="true">cake</span>
          </md-filled-text-field>

          <div id="parent-email-section" style="display: none;">
            <md-filled-text-field id="parent-email"
                                  class="d-block w-100 mb-2"
                                  label="{{ 'register.parentEmail'|trans({}, 'catroweb') }}"
                                  supporting-text="{{ 'register.parentEmailInfo'|trans({}, 'catroweb') }}"
                                  name="parent_email"
                                  type="email"
                                  tabindex="2">
              <span slot="leading-icon" class="material-icons" aria-hidden="true">family_restroom</span>
            </md-filled-text-field>
          </div>

          <div class="mt-3">
            <button type="submit" class="btn btn-primary">
              {{ 'register.completeRegistration.submit'|trans({}, 'catroweb') }}
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const dobInput = document.getElementById('date-of-birth')
      const parentSection = document.getElementById('parent-email-section')
      if (dobInput && parentSection) {
        dobInput.addEventListener('change', function () {
          const dob = dobInput.value
          if (!dob) {
            parentSection.style.display = 'none'
            return
          }
          const msPerYear = 365.25 * 24 * 60 * 60 * 1000
          const age = Math.floor((new Date() - new Date(dob)) / msPerYear)
          parentSection.style.display = age < 14 ? '' : 'none'
        })
      }
    })
  </script>

{% endblock body %}
